    "def plot_rules_table(top_r, title, filename):\n",
    "    if top_r.empty:\n",
    "        print(f'No rules to display for: {title}')\n",
    "        return\n",
    "    ants  = top_r['antecedents'].apply(lambda x: ', '.join(sorted(x))).tolist()\n",
    "    cons  = top_r['consequents'].apply(lambda x: ', '.join(sorted(x))).tolist()\n",
    "    sups  = top_r['support'].astype(float).round(4).tolist()\n",
    "    confs = top_r['confidence'].astype(float).round(4).tolist()\n",
    "    lifs  = top_r['lift'].astype(float).round(4).tolist()\n",
    "\n",
    "    col_labels = ['#', 'Antecedent', 'Consequent', 'Support', 'Confidence', 'Lift']\n",
    "    table_data = [\n",
    "        [i+1, a, c, f'{s:.4f}', f'{cf:.4f}', f'{l:.4f}']\n",
    "        for i, (a, c, s, cf, l) in enumerate(zip(ants, cons, sups, confs, lifs))\n",
    "    ]\n",
    "    fig, ax = plt.subplots(figsize=(14, 5))\n",
    "    ax.axis('off')\n",
    "    tbl = ax.table(cellText=table_data, colLabels=col_labels, loc='center', cellLoc='center')\n",
    "    tbl.auto_set_font_size(False)\n",
    "    tbl.set_fontsize(9)\n",
    "    tbl.scale(1, 1.6)\n",
    "    for col in range(len(col_labels)):\n",
    "        tbl[0, col].set_facecolor('#4472C4')\n",
    "        tbl[0, col].set_text_props(color='white', fontweight='bold')\n",
    "    for row in range(1, len(table_data) + 1):\n",
    "        bg = '#DCE6F1' if row % 2 == 0 else 'white'\n",
    "        for col in range(len(col_labels)):\n",
    "            tbl[row, col].set_facecolor(bg)\n",
    "    ax.set_title(title, fontsize=13, fontweight='bold', pad=20, y=0.98)\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(filename, dpi=150, bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "plot_rules_table(top_rules_apriori,\n",
    "                 'Top-10 Apriori Rules Ranked by Lift',\n",
    "                 'apriori_top_rules_table.png')\n"
   ]
  },
