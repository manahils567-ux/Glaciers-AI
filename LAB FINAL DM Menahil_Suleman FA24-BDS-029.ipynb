    "    - average basket size\n",
    "    \"\"\"\n",
    "\n",
    "    total_transactions = len(transactions)\n",
    "\n",
    "    unique_items = set()\n",
    "    basket_sizes = []\n",
    "\n",
    "    for basket in transactions:\n",
