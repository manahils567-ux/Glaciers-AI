   ],
   "source": [
    "def get_rules(itemsets, min_conf):\n",
    "    return association_rules(itemsets, metric='confidence', min_threshold=min_conf)\n",
    "\n",
    "# --- Apriori ---\n",
    "print('Apriori RUNNING')\n",
    "start = time.time()\n",
    "fi_apriori = apriori(df, min_support=MIN_SUPPORT, use_colnames=True)\n",
    "fi_apriori['itemset_size'] = fi_apriori['itemsets'].apply(len)\n",
    "rules_apriori = get_rules(fi_apriori, MIN_CONFIDENCE)\n",
    "rules_apriori = rules_apriori[rules_apriori['lift'] > MIN_LIFT]\n",
    "apriori_time = time.time() - start\n",
    "print('Apriori time:', round(apriori_time, 4))\n",
    "print('Apriori itemsets:', len(fi_apriori))\n",
    "print('Apriori rules:', len(rules_apriori))\n",
    "\n",
    "# --- FP-Growth ---\n",
    "print('\\nFP-Growth RUNNING')\n",
    "start = time.time()\n",
    "frequent_itemsets = fpgrowth(df, min_support=MIN_SUPPORT, use_colnames=True)\n",
    "frequent_itemsets['itemset_size'] = frequent_itemsets['itemsets'].apply(len)\n",
    "rules = get_rules(frequent_itemsets, MIN_CONFIDENCE)\n",
    "rules = rules[rules['lift'] > MIN_LIFT]\n",
    "fpgrowth_time = time.time() - start\n",
    "print('FP-Growth time:', round(fpgrowth_time, 4))\n",
    "print('FP-Growth itemsets:', len(frequent_itemsets))\n",
    "print('FP-Growth rules:', len(rules))\n"
   ]
  },
