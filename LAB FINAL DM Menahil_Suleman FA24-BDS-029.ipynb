    "algos = ['Apriori', 'FP-Growth']\n",
    "colors = ['#FF6B6B', '#4D96FF']\n",
    "\n",
    "runtime_vals   = [apriori_time, fpgrowth_time]\n",
    "rules_vals     = [len(rules_apriori), len(rules)]\n",
    "itemset_vals   = [len(fi_apriori), len(frequent_itemsets)]\n",
    "avg_lift_vals  = [\n",
    "    rules_apriori['lift'].mean() if not rules_apriori.empty else 0,\n",
    "    rules['lift'].mean()         if not rules.empty         else 0\n",
    "]\n",
    "\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 8))\n",
    "fig.suptitle('Apriori vs FP-Growth — Full Comparison', fontsize=15, fontweight='bold')\n",
    "\n",
    "metrics = [\n",
    "    (axes[0, 0], runtime_vals,  'Runtime (seconds)',          'Seconds'),\n",
    "    (axes[0, 1], rules_vals,    'Rules Generated',            'Count'),\n",
    "    (axes[1, 0], itemset_vals,  'Frequent Itemsets Found',    'Count'),\n",
    "    (axes[1, 1], avg_lift_vals, 'Average Lift of Rules',      'Lift'),\n",
    "]\n",
    "\n",
    "for ax, vals, title, ylabel in metrics:\n",
    "    bars = ax.bar(algos, vals, color=colors, edgecolor='white', width=0.45)\n",
    "    ax.set_title(title, fontsize=12, fontweight='bold')\n",
    "    ax.set_ylabel(ylabel, fontsize=10)\n",
    "    ax.spines[['top', 'right']].set_visible(False)\n",
    "    ax.grid(axis='y', linestyle='--', alpha=0.4)\n",
    "    for b in bars:\n",
    "        ax.text(b.get_x() + b.get_width()/2,\n",
    "                b.get_height() + max(vals) * 0.02,\n",
    "                f'{b.get_height():.3f}' if max(vals) < 5 else str(int(b.get_height())),\n",
    "                ha='center', va='bottom', fontsize=10, fontweight='bold')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('final_comparison.png', dpi=150, bbox_inches='tight')\n",
    "plt.show()"
   ]
