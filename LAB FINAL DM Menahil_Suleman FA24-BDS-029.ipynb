    "# Get top-10 items by frequency\n",
    "item_freq = df.sum().sort_values(ascending=False)\n",
    "top10 = item_freq.head(10).index.tolist()\n",
    "\n",
    "# Build co-occurrence matrix\n",
    "co_matrix = pd.DataFrame(0, index=top10, columns=top10)\n",
    "df_top = df[top10]\n",
    "for i in top10:\n",
    "    for j in top10:\n",
    "        if i == j:\n",
    "            co_matrix.loc[i, j] = 0  # hide diagonal\n",
    "        else:\n",
    "            co_matrix.loc[i, j] = (df_top[i] & df_top[j]).sum()\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 8))\n",
    "im = ax.imshow(co_matrix.values, cmap='YlOrRd', aspect='auto')\n",
    "plt.colorbar(im, ax=ax, label='Co-occurrence Count')\n",
    "\n",
    "ax.set_xticks(range(len(top10)))\n",
    "ax.set_yticks(range(len(top10)))\n",
    "ax.set_xticklabels(top10, rotation=45, ha='right', fontsize=10)\n",
    "ax.set_yticklabels(top10, fontsize=10)\n",
    "\n",
    "# Add count annotations\n",
